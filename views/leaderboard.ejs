<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Leaderboard – NeuronLearn</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0b0f1a;
      --surface: #111827;
      --card: #161d2e;
      --border: #1f2d47;
      --accent: #00e5ff;
      --accent2: #7c3aed;
      --accent3: #f59e0b;
      --text: #e2e8f0;
      --muted: #64748b;
      --success: #10b981;
      --danger: #ef4444;
      --gold: #fbbf24;
      --silver: #94a3b8;
      --bronze: #d97706;
    }

    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

    /* Sidebar */
    .sidebar { width: 260px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; }
    .logo { padding: 28px 24px 20px; border-bottom: 1px solid var(--border); }
    .logo-text { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .logo-sub { font-size: 11px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-top: 2px; }
    nav { padding: 20px 12px; flex: 1; }
    .nav-section-title { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted); padding: 0 12px 8px; }
    .nav-item { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 10px; font-size: 14px; font-weight: 500; color: var(--muted); cursor: pointer; transition: all 0.2s; margin-bottom: 2px; text-decoration: none; }
    .nav-item:hover { background: var(--border); color: var(--text); }
    .nav-item.active { background: linear-gradient(135deg, rgba(0,229,255,0.15), rgba(124,58,237,0.1)); color: var(--accent); border: 1px solid rgba(0,229,255,0.2); }
    .nav-icon { font-size: 18px; width: 22px; text-align: center; }
    .nav-badge { margin-left: auto; background: var(--accent2); color: #fff; font-size: 10px; padding: 2px 7px; border-radius: 20px; }
    .sidebar-user { padding: 16px 20px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
    .avatar-sm { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--accent2), var(--accent)); display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px; }
    .user-info .name { font-size: 14px; font-weight: 600; }
    .user-info .role { font-size: 11px; color: var(--muted); }

    /* Main */
    .main { margin-left: 260px; flex: 1; padding: 32px 36px; }

    /* Hero */
    .lb-hero {
      background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(0,229,255,0.08));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .lb-hero::before {
      content: '🏆';
      position: absolute;
      right: 40px; top: 50%;
      transform: translateY(-50%);
      font-size: 90px;
      opacity: 0.08;
    }
    .lb-hero-title { font-family: 'Syne', sans-serif; font-size: 30px; font-weight: 800; margin-bottom: 6px; }
    .lb-hero-title span { color: var(--gold); }
    .lb-hero-sub { font-size: 14px; color: var(--muted); margin-bottom: 20px; }

    .hero-stats { display: flex; gap: 24px; }
    .hero-stat { text-align: center; }
    .hs-val { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; }
    .hs-val.gold { color: var(--gold); }
    .hs-val.cyan { color: var(--accent); }
    .hs-val.purple { color: #a78bfa; }
    .hs-label { font-size: 11px; color: var(--muted); margin-top: 2px; }

    /* Tabs + Controls */
    .controls { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
    .tabs { display: flex; gap: 4px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 4px; }
    .tab-btn { padding: 8px 18px; border-radius: 8px; border: none; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; background: none; color: var(--muted); font-family: 'DM Sans', sans-serif; }
    .tab-btn.active { background: var(--surface); color: var(--text); box-shadow: 0 2px 8px rgba(0,0,0,0.3); }
    .time-select { margin-left: auto; background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 9px 16px; font-size: 13px; outline: none; font-family: 'DM Sans', sans-serif; }
    .search-wrap2 { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 9px 14px; }
    .search-wrap2 input { background: none; border: none; outline: none; color: var(--text); font-size: 14px; width: 180px; font-family: 'DM Sans', sans-serif; }
    .search-wrap2 input::placeholder { color: var(--muted); }

    /* Two-column layout */
    .lb-layout { display: grid; grid-template-columns: 1fr 300px; gap: 24px; }

    /* Podium */
    .podium { display: flex; align-items: flex-end; justify-content: center; gap: 20px; margin-bottom: 28px; }
    .podium-item { text-align: center; display: flex; flex-direction: column; align-items: center; }
    .podium-avatar-wrap { position: relative; margin-bottom: 12px; }
    .podium-avatar {
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-family: 'Syne', sans-serif; font-weight: 800;
    }
    .podium-avatar.first { width: 72px; height: 72px; font-size: 22px; background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #1a1000; box-shadow: 0 0 30px rgba(251,191,36,0.4); }
    .podium-avatar.second { width: 60px; height: 60px; font-size: 18px; background: linear-gradient(135deg, #94a3b8, #64748b); color: #fff; }
    .podium-avatar.third { width: 54px; height: 54px; font-size: 16px; background: linear-gradient(135deg, #d97706, #92400e); color: #fff; }
    .medal { position: absolute; bottom: -4px; right: -4px; font-size: 20px; }
    .podium-name { font-size: 13px; font-weight: 600; margin-bottom: 3px; }
    .podium-xp { font-size: 12px; }
    .podium-xp.gold { color: var(--gold); }
    .podium-xp.silver { color: var(--silver); }
    .podium-xp.bronze { color: var(--bronze); }
    .podium-base {
      border-radius: 10px 10px 0 0; width: 110px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800;
      color: rgba(255,255,255,0.5);
    }
    .base-first { height: 80px; background: linear-gradient(180deg, rgba(251,191,36,0.25), rgba(251,191,36,0.1)); border: 1px solid rgba(251,191,36,0.3); }
    .base-second { height: 60px; background: linear-gradient(180deg, rgba(148,163,184,0.2), rgba(148,163,184,0.08)); border: 1px solid rgba(148,163,184,0.2); }
    .base-third { height: 45px; background: linear-gradient(180deg, rgba(217,119,6,0.2), rgba(217,119,6,0.08)); border: 1px solid rgba(217,119,6,0.2); }

    /* Table */
    .lb-table { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
    .table-header {
      display: grid; grid-template-columns: 56px 1fr 100px 100px 80px 80px;
      padding: 14px 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); font-weight: 600;
    }
    .lb-row {
      display: grid; grid-template-columns: 56px 1fr 100px 100px 80px 80px;
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
      align-items: center;
      transition: background 0.2s;
    }
    .lb-row:last-child { border-bottom: none; }
    .lb-row:hover { background: rgba(255,255,255,0.02); }
    .lb-row.highlight { background: linear-gradient(135deg, rgba(0,229,255,0.05), rgba(124,58,237,0.03)); border-left: 3px solid var(--accent); }

    .rank-num { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; }
    .rank-1 { color: var(--gold); }
    .rank-2 { color: var(--silver); }
    .rank-3 { color: var(--bronze); }
    .rank-other { color: var(--muted); }

    .user-cell { display: flex; align-items: center; gap: 12px; }
    .lb-av { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; font-family: 'Syne', sans-serif; flex-shrink: 0; }
    .user-details .uname { font-size: 14px; font-weight: 600; }
    .user-details .ulevel { font-size: 11px; color: var(--muted); }

    .xp-val { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--accent3); }
    .streak-val { display: flex; align-items: center; gap: 4px; font-size: 13px; }
    .badge-count { display: flex; gap: 3px; }
    .mini-badge { font-size: 14px; }

    .change-up { color: var(--success); font-size: 12px; font-weight: 600; }
    .change-down { color: var(--danger); font-size: 12px; font-weight: 600; }
    .change-same { color: var(--muted); font-size: 12px; }

    /* Right: User Card + Challenges */
    .right-panel { display: flex; flex-direction: column; gap: 20px; }

    .my-rank-card {
      background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(0,229,255,0.08));
      border: 1px solid rgba(0,229,255,0.2);
      border-radius: 16px; padding: 22px; text-align: center;
    }
    .mrc-label { font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted); margin-bottom: 10px; }
    .mrc-rank { font-family: 'Syne', sans-serif; font-size: 52px; font-weight: 800; color: var(--accent); line-height: 1; }
    .mrc-rank span { font-size: 20px; color: var(--muted); }
    .mrc-name { font-size: 15px; font-weight: 600; margin-top: 8px; }
    .mrc-xp { font-size: 13px; color: var(--accent3); margin-top: 3px; }
    .mrc-progress-label { font-size: 11px; color: var(--muted); margin: 14px 0 6px; }
    .mrc-bar { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
    .mrc-fill { height: 100%; background: linear-gradient(90deg, var(--accent2), var(--accent)); border-radius: 3px; }
    .mrc-gap { font-size: 11px; color: var(--muted); margin-top: 6px; }

    /* Challenges */
    .challenges-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; }
    .ch-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 16px; }
    .challenge-item { padding: 12px 0; border-bottom: 1px solid var(--border); }
    .challenge-item:last-child { border-bottom: none; }
    .ch-name { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
    .ch-bar { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; margin-bottom: 5px; }
    .ch-fill { height: 100%; border-radius: 2px; }
    .ch-meta { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); }
    .ch-reward { color: var(--accent3); font-weight: 600; }

    /* Top Movers */
    .movers-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; }
    .mv-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 14px; }
    .mover-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); }
    .mover-item:last-child { border-bottom: none; }
    .mv-av { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
    .mv-name { flex: 1; font-size: 13px; font-weight: 500; }
    .mv-change { font-size: 12px; font-weight: 700; }
    .mv-up { color: var(--success); }
    .mv-down { color: var(--danger); }

    @keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
    .lb-row { animation: fadeUp 0.3s ease both; }
    <% for(let i=0;i<10;i++) { %>.lb-row:nth-child(<%= i+1 %>) { animation-delay: <%= i*0.04 %>s; }<% } %>
  </style>
</head>
<body>

<!-- Sidebar -->
<aside class="sidebar">
  <div class="logo">
    <div class="logo-text">NeuronLearn</div>
    <div class="logo-sub">Smart Learning Platform</div>
  </div>
  <nav>
    <div class="nav-section-title">Main</div>
    <a href="/dashboard" class="nav-item"><span class="nav-icon">⬡</span> Dashboard</a>
    <a href="/courses" class="nav-item"><span class="nav-icon">📚</span> Courses <span class="nav-badge">12</span></a>
    <a href="/leaderboard" class="nav-item active"><span class="nav-icon">🏆</span> Leaderboard</a>
    <a href="/practice" class="nav-item"><span class="nav-icon">⚡</span> Practice</a>
    <div class="nav-section-title" style="margin-top:20px;">Account</div>
    <a href="/profile" class="nav-item"><span class="nav-icon">👤</span> Profile</a>
    <a href="/achievements" class="nav-item"><span class="nav-icon">🎖️</span> Achievements</a>
    <a href="/settings" class="nav-item"><span class="nav-icon">⚙️</span> Settings</a>
  </nav>
  <div class="sidebar-user">
    <div class="avatar-sm"><%= user ? user.initials : 'AK' %></div>
    <div class="user-info">
      <div class="name"><%= user ? user.name : 'Arjun Kumar' %></div>
      <div class="role">Pro Learner · Lvl <%= user ? user.level : 14 %></div>
    </div>
  </div>
</aside>

<!-- Main -->
<main class="main">

  <!-- Hero -->
  <div class="lb-hero">
    <div class="lb-hero-title">🏆 <span>Global</span> Leaderboard</div>
    <div class="lb-hero-sub">Compete with learners worldwide. Top 3 this month win exclusive badges!</div>
    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hs-val gold">#<%= currentUserRank || 2 %></div>
        <div class="hs-label">Your Rank</div>
      </div>
      <div style="width:1px;background:var(--border);height:40px;align-self:center;"></div>
      <div class="hero-stat">
        <div class="hs-val cyan"><%= totalLearners || '2,841' %></div>
        <div class="hs-label">Total Learners</div>
      </div>
      <div style="width:1px;background:var(--border);height:40px;align-self:center;"></div>
      <div class="hero-stat">
        <div class="hs-val purple"><%= daysLeft || 14 %> days</div>
        <div class="hs-label">Season Ends In</div>
      </div>
    </div>
  </div>

  <!-- Controls -->
  <div class="controls">
    <div class="tabs">
      <button class="tab-btn active">Global</button>
      <button class="tab-btn">Friends</button>
      <button class="tab-btn">My Courses</button>
      <button class="tab-btn">Country</button>
    </div>
    <div class="search-wrap2">
      <span style="color:var(--muted)">🔍</span>
      <input type="text" placeholder="Find a learner..." />
    </div>
    <select class="time-select">
      <option>This Month</option>
      <option>This Week</option>
      <option>All Time</option>
    </select>
  </div>

  <div class="lb-layout">
    <!-- Left: Podium + Table -->
    <div>
      <!-- Podium -->
      <%
      const topThree = podium || [
        { name: 'Priya S.', xp: '9,420 XP', initials: 'PS', av: 'linear-gradient(135deg,#7c3aed,#a855f7)' },
        { name: 'Arjun K.', xp: '4,820 XP', initials: 'AK', av: 'linear-gradient(135deg,#0891b2,#00e5ff)' },
        { name: 'Riya M.', xp: '4,110 XP', initials: 'RM', av: 'linear-gradient(135deg,#059669,#10b981)' }
      ];
      %>
      <div class="podium">
        <!-- 2nd -->
        <div class="podium-item">
          <div class="podium-avatar-wrap">
            <div class="podium-avatar second" style="background:<%= topThree[1].av %>"><%= topThree[1].initials %></div>
            <span class="medal">🥈</span>
          </div>
          <div class="podium-name"><%= topThree[1].name %></div>
          <div class="podium-xp silver"><%= topThree[1].xp %></div>
          <div class="podium-base base-second">2</div>
        </div>
        <!-- 1st -->
        <div class="podium-item">
          <div class="podium-avatar-wrap">
            <div class="podium-avatar first" style="background:<%= topThree[0].av %>"><%= topThree[0].initials %></div>
            <span class="medal">👑</span>
          </div>
          <div class="podium-name"><%= topThree[0].name %></div>
          <div class="podium-xp gold"><%= topThree[0].xp %></div>
          <div class="podium-base base-first">1</div>
        </div>
        <!-- 3rd -->
        <div class="podium-item">
          <div class="podium-avatar-wrap">
            <div class="podium-avatar third" style="background:<%= topThree[2].av %>"><%= topThree[2].initials %></div>
            <span class="medal">🥉</span>
          </div>
          <div class="podium-name"><%= topThree[2].name %></div>
          <div class="podium-xp bronze"><%= topThree[2].xp %></div>
          <div class="podium-base base-third">3</div>
        </div>
      </div>

      <!-- Full Table -->
      <div class="lb-table">
        <div class="table-header">
          <div>Rank</div>
          <div>Learner</div>
          <div>XP</div>
          <div>Streak</div>
          <div>Badges</div>
          <div>Change</div>
        </div>
        <%
        const rows = leaderboard || [
          { rank:1, name:'Priya Sharma', level:22, xp:'9,420', streak:45, badges:['🏆','⭐','🔥'], change:'+0', av:'linear-gradient(135deg,#7c3aed,#a855f7)', initials:'PS', me:false },
          { rank:2, name:'Arjun Kumar', level:14, xp:'4,820', streak:21, badges:['⭐','🔥'], change:'—', av:'linear-gradient(135deg,#0891b2,#00e5ff)', initials:'AK', me:true },
          { rank:3, name:'Riya Mehta', level:17, xp:'4,110', streak:18, badges:['⚡','🔥'], change:'+2', av:'linear-gradient(135deg,#059669,#10b981)', initials:'RM', me:false },
          { rank:4, name:'Dev Trivedi', level:12, xp:'3,980', streak:14, badges:['⭐'], change:'-1', av:'linear-gradient(135deg,#d97706,#f59e0b)', initials:'DT', me:false },
          { rank:5, name:'Sneha Patil', level:11, xp:'3,450', streak:9, badges:['🔥'], change:'-1', av:'linear-gradient(135deg,#be185d,#ec4899)', initials:'SP', me:false },
          { rank:6, name:'Aditya Rao', level:10, xp:'3,100', streak:7, badges:['⭐'], change:'+4', av:'linear-gradient(135deg,#4f46e5,#818cf8)', initials:'AR', me:false },
          { rank:7, name:'Neha Joshi', level:9, xp:'2,870', streak:5, badges:[], change:'+1', av:'linear-gradient(135deg,#0f766e,#2dd4bf)', initials:'NJ', me:false },
          { rank:8, name:'Rohit Singh', level:9, xp:'2,640', streak:3, badges:['⚡'], change:'-2', av:'linear-gradient(135deg,#7f1d1d,#ef4444)', initials:'RS', me:false }
        ];
        %>
        <% rows.forEach(function(r) { %>
        <div class="lb-row <%= r.me ? 'highlight' : '' %>">
          <div class="rank-num <%= r.rank===1?'rank-1':r.rank===2?'rank-2':r.rank===3?'rank-3':'rank-other' %>">
            <%= r.rank <= 3 ? ['🥇','🥈','🥉'][r.rank-1] : r.rank %>
          </div>
          <div class="user-cell">
            <div class="lb-av" style="background:<%= r.av %>"><%= r.initials %></div>
            <div class="user-details">
              <div class="uname"><%= r.name %> <%= r.me ? '<span style="font-size:11px;color:var(--accent);background:rgba(0,229,255,0.1);padding:2px 7px;border-radius:4px;margin-left:4px;">You</span>' : '' %></div>
              <div class="ulevel">Level <%= r.level %></div>
            </div>
          </div>
          <div class="xp-val"><%= r.xp %></div>
          <div class="streak-val">🔥 <span><%= r.streak %>d</span></div>
          <div class="badge-count">
            <% r.badges.forEach(function(b) { %><span class="mini-badge"><%= b %></span><% }) %>
            <% if(r.badges.length === 0) { %><span style="color:var(--muted);font-size:12px;">—</span><% } %>
          </div>
          <div class="<%= r.change.startsWith('+') ? 'change-up' : r.change.startsWith('-') ? 'change-down' : 'change-same' %>">
            <%= r.change %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Right Panel -->
    <div class="right-panel">
      <!-- My Rank Card -->
      <div class="my-rank-card">
        <div class="mrc-label">Your Standing</div>
        <div class="mrc-rank">#<%= currentUserRank || 2 %><span> / <%= totalLearners || '2,841' %></span></div>
        <div class="mrc-name"><%= user ? user.name : 'Arjun Kumar' %></div>
        <div class="mrc-xp">4,820 XP · Level 14</div>
        <div class="mrc-progress-label">Progress to #1</div>
        <div class="mrc-bar"><div class="mrc-fill" style="width:51%"></div></div>
        <div class="mrc-gap">4,600 XP behind Priya S.</div>
      </div>

      <!-- Weekly Challenges -->
      <div class="challenges-card">
        <div class="ch-title">⚡ Weekly Challenges</div>
        <div class="challenge-item">
          <div class="ch-name">🎯 Complete 5 Quizzes</div>
          <div class="ch-bar"><div class="ch-fill" style="width:60%;background:linear-gradient(90deg,var(--accent2),var(--accent))"></div></div>
          <div class="ch-meta"><span>3 / 5 done</span><span class="ch-reward">+200 XP</span></div>
        </div>
        <div class="challenge-item">
          <div class="ch-name">📘 Study 3 Days Straight</div>
          <div class="ch-bar"><div class="ch-fill" style="width:100%;background:linear-gradient(90deg,var(--success),#34d399)"></div></div>
          <div class="ch-meta"><span style="color:var(--success)">✓ Completed!</span><span class="ch-reward">+150 XP</span></div>
        </div>
        <div class="challenge-item">
          <div class="ch-name">🚀 Finish a Chapter</div>
          <div class="ch-bar"><div class="ch-fill" style="width:30%;background:linear-gradient(90deg,var(--accent3),#f97316)"></div></div>
          <div class="ch-meta"><span>1 / 3 done</span><span class="ch-reward">+300 XP</span></div>
        </div>
      </div>

      <!-- Top Movers -->
      <div class="movers-card">
        <div class="mv-title">📈 Top Movers Today</div>
        <% const movers = [
          { name:'Aditya R.', change:'+12', initials:'AR', av:'linear-gradient(135deg,#4f46e5,#818cf8)', dir:'up' },
          { name:'Neha J.', change:'+8', initials:'NJ', av:'linear-gradient(135deg,#0f766e,#2dd4bf)', dir:'up' },
          { name:'Priya S.', change:'+5', initials:'PS', av:'linear-gradient(135deg,#7c3aed,#a855f7)', dir:'up' },
          { name:'Rohit S.', change:'-3', initials:'RS', av:'linear-gradient(135deg,#7f1d1d,#ef4444)', dir:'down' }
        ]; %>
        <% movers.forEach(function(m) { %>
        <div class="mover-item">
          <div class="mv-av" style="background:<%= m.av %>"><%= m.initials %></div>
          <div class="mv-name"><%= m.name %></div>
          <div class="mv-change <%= m.dir==='up' ? 'mv-up' : 'mv-down' %>"><%= m.change %> ranks</div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</main>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>
</body>
</html>
